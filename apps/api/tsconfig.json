{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Repetidas del tsconfig base: el build de Vercel (Root Directory apps/api) no lo lee.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "noEmit": true,
    "lib": ["ES2023"]
  },
  "include": ["src", "test", "api", "vitest.config.ts"]
}
