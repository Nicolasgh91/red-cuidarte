# URL de la API (apps/api). En desarrollo: http://localhost:8787
VITE_API_URL=http://localhost:8787
# Proyecto de Supabase (Settings > API). La anon key es pública, pero no pongas acá la service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true: el ingreso muestra un selector con los usuarios de la base (requiere DEMO_MODE=true en la API)
VITE_DEMO_MODE=false
